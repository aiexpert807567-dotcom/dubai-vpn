# Copy this file to .env and fill in real values. NEVER commit .env.
# Generate a secret with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=development
JWT_SECRET=CHANGE_ME
DATABASE_URL=sqlite:///./dubai_vpn.db

# Internal-only AdGuard Home API (never exposed publicly)
ADGUARD_URL=http://127.0.0.1:3000
ADGUARD_USER=CHANGE_ME
ADGUARD_PASSWORD=CHANGE_ME

# WireGuard server details (filled in during Phase 6)
WG_INTERFACE=wg0
WG_SERVER_PUBLIC_KEY=CHANGE_ME
WG_ENDPOINT=CHANGE_ME:51820
